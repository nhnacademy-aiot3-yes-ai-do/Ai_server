# AI 일일 피드백 로컬 통합 테스트
#
# 실행 전 http/LOCAL_DAILY_FEEDBACK_TEST.md를 먼저 읽어 주세요.
# feedbackDate는 반드시 사진을 업로드하는 현재 한국 날짜로 바꿉니다.
# 같은 cultivationId + feedbackDate에는 사진을 정확히 한 장만 업로드합니다.

@ai = http://localhost:8080
@vision = http://localhost:8000
@cultivation = http://localhost:8084
@notification = http://localhost:9005
@cultivationId = 28
@ownerUserId = 22
@feedbackDate = 2026-09-02

### 1. Vision Server 생존 상태 확인
GET {{vision}}/health/live
Accept: application/json

> {%
client.test("Vision Server가 실행 중이다", function () {
    client.assert(response.status === 200, "Vision live 응답은 HTTP 200이어야 합니다.");
});
%}

### 2. Vision Server 모델 준비 상태 확인
GET {{vision}}/health/ready
Accept: application/json

> {%
client.test("Vision 모델이 요청 가능한 상태이다", function () {
    client.assert(response.status === 200, "Vision ready 응답은 HTTP 200이어야 합니다.");
});
%}

### 3. Notification Server 준비 상태 확인
GET {{notification}}/actuator/health
Accept: application/json

> {%
client.test("Notification 통계 API를 호출할 수 있는 상태이다", function () {
    client.assert(response.status === 200, "Notification health 응답은 HTTP 200이어야 합니다.");
    client.assert(response.body.status === "UP", "Notification Server 상태가 UP이어야 합니다.");
});
%}

### 4. AI -> Vision multipart 호출만 먼저 확인
POST {{ai}}/api/test/vision
Content-Type: multipart/form-data; boundary=DailyFeedbackBoundary

--DailyFeedbackBoundary
Content-Disposition: form-data; name="image"; filename="mushroom.jpg"
Content-Type: image/jpeg

< ./local-test-images/mushroom.jpg
--DailyFeedbackBoundary--

> {%
client.test("AI가 Vision 응답 계약을 그대로 수신한다", function () {
    client.assert(response.status === 200, "AI Vision relay 응답은 HTTP 200이어야 합니다.");
    client.assert(response.body.analysisType === "MUSHROOM_HEALTH_CHECK_V1",
        "analysisType이 MUSHROOM_HEALTH_CHECK_V1이어야 합니다.");
    client.assert(response.body.status === "SUCCESS"
        || response.body.status === "NO_MUSHROOM_DETECTED",
        "Vision status는 SUCCESS 또는 NO_MUSHROOM_DETECTED여야 합니다.");
    client.assert(Array.isArray(response.body.results), "results는 배열이어야 합니다.");
    client.assert(Array.isArray(response.body.warnings), "warnings는 배열이어야 합니다.");
});
%}

### 5. 업로드 전 해당 날짜/재배지의 피드백이 아직 없는지 확인
# 404가 정상입니다. 200이면 이미 저장된 피드백이 있으므로 이 날짜에는 사진 통합 테스트를 시작하지 않습니다.
GET {{ai}}/api/test/daily-feedbacks/{{cultivationId}}?date={{feedbackDate}}
Accept: application/json

> {%
client.test("테스트 대상에는 아직 저장된 일일 피드백이 없다", function () {
    client.assert(response.status === 404,
        "사진 업로드 전 조회는 HTTP 404여야 합니다. 200이면 다른 재배지·날짜 조합을 선택하세요.");
});
%}

### 6. 업로드 전 해당 날짜의 사진 계약 전체 확인
# 이 요청 응답에는 만료되는 presignedUrl이 포함됩니다. 응답을 공유하거나 로그로 복사하지 마세요.
GET {{cultivation}}/api/v1/internal/cultivations/photos/daily?date={{feedbackDate}}
Accept: application/json

> {%
client.test("테스트 대상에는 아직 오늘 사진이 없다", function () {
    client.assert(response.status === 200, "일별 사진 조회는 HTTP 200이어야 합니다.");
    client.assert(response.body.targetDate === client.variables.file.get("feedbackDate"),
        "응답 날짜가 feedbackDate와 같아야 합니다.");
    client.assert(Array.isArray(response.body.photos), "photos는 배열이어야 합니다.");

    const photoCountsByCultivation = {};
    response.body.photos.forEach(function (photo) {
        const key = String(photo.cultivationId);
        photoCountsByCultivation[key] = (photoCountsByCultivation[key] || 0) + 1;
    });
    const duplicateCultivationIds = Object.keys(photoCountsByCultivation).filter(function (key) {
        return photoCountsByCultivation[key] > 1;
    });
    client.assert(duplicateCultivationIds.length === 0,
        "다른 재배지를 포함해 같은 날짜에 사진이 두 장 이상인 재배지가 없어야 합니다.");

    const targetCultivationId = Number(client.variables.file.get("cultivationId"));
    const matchingPhotos = response.body.photos.filter(function (photo) {
        return Number(photo.cultivationId) === targetCultivationId;
    });

    client.assert(matchingPhotos.length === 0,
        "이미 같은 날짜의 사진이 있습니다. 중복 업로드하지 말고 안내서의 충돌 해결 절차를 확인하세요.");
});
%}

### 7. Cultivation Server에 테스트 사진 한 장 업로드
< {%
client.global.clear("uploadedDailyFeedbackPhotoId");
%}
POST {{cultivation}}/api/v1/cultivations/{{cultivationId}}/photos
X-User-Id: {{ownerUserId}}
Content-Type: multipart/form-data; boundary=DailyFeedbackBoundary

--DailyFeedbackBoundary
Content-Disposition: form-data; name="file"; filename="mushroom.jpg"
Content-Type: image/jpeg

< ./local-test-images/mushroom.jpg
--DailyFeedbackBoundary--

> {%
client.test("Cultivation 사진 업로드가 성공한다", function () {
    client.assert(response.status === 201, "사진 업로드는 HTTP 201이어야 합니다.");
    client.assert(Number(response.body.photoId) > 0, "photoId는 양수여야 합니다.");
    client.assert(response.body.storageType !== null && response.body.storageType !== undefined,
        "storageType이 있어야 합니다.");
    client.assert(response.body.updatedAt !== null && response.body.updatedAt !== undefined,
        "updatedAt이 있어야 합니다.");

    // URL이나 objectKey는 저장하지 않고 이후 교차 검증에 필요한 ID만 보관합니다.
    client.global.set("uploadedDailyFeedbackPhotoId", String(response.body.photoId));
});
%}

### 8. 일별 사진 계약에서 방금 올린 사진이 정확히 한 장 조회되는지 확인
# 응답의 presignedUrl은 30분 만료값이므로 외부에 공유하지 마세요.
GET {{cultivation}}/api/v1/internal/cultivations/photos/daily?date={{feedbackDate}}
Accept: application/json

> {%
client.test("일별 사진 조회가 업로드한 사진 한 장을 반환한다", function () {
    client.assert(response.status === 200, "일별 사진 조회는 HTTP 200이어야 합니다.");

    const targetCultivationId = Number(client.variables.file.get("cultivationId"));
    const matchingPhotos = response.body.photos.filter(function (photo) {
        return Number(photo.cultivationId) === targetCultivationId;
    });

    client.assert(matchingPhotos.length === 1,
        "대상 날짜와 재배지에는 사진이 정확히 한 장이어야 합니다.");

    const uploadedPhotoId = client.global.get("uploadedDailyFeedbackPhotoId");
    client.assert(uploadedPhotoId !== null && uploadedPhotoId !== undefined,
        "7번 사진 업로드 요청을 먼저 성공시켜야 합니다.");
    client.assert(Number(matchingPhotos[0].photoId) === Number(uploadedPhotoId),
        "일별 조회 photoId가 방금 업로드한 photoId와 같아야 합니다.");

    client.assert(typeof matchingPhotos[0].presignedUrl === "string"
        && matchingPhotos[0].presignedUrl.length > 0,
        "presignedUrl이 있어야 합니다.");
    client.assert(matchingPhotos[0].expiresAt !== null
        && matchingPhotos[0].expiresAt !== undefined,
        "expiresAt이 있어야 합니다.");
});
%}

### 9. 해당 날짜의 일일 피드백 배치 수동 실행
# 배치는 모든 활성 재배지를 처리합니다. 다른 재배지 실패가 있어도 아래 검증은 28번 결과를 별도로 확인합니다.
POST {{ai}}/api/test/daily-feedbacks/run?date={{feedbackDate}}
Accept: application/json

> {%
client.test("테스트 재배지의 일일 피드백이 처음 생성된다", function () {
    client.assert(response.status === 200, "일일 피드백 배치는 HTTP 200이어야 합니다.");
    client.assert(response.body.success === true, "공통 응답 success가 true여야 합니다.");

    const data = response.body.data;
    client.assert(data.feedbackDate === client.variables.file.get("feedbackDate"),
        "배치 결과 날짜가 feedbackDate와 같아야 합니다.");
    client.assert(data.targetCount === data.createdCount + data.existingCount + data.failedCount,
        "상태별 합계가 targetCount와 같아야 합니다.");
    client.assert(Array.isArray(data.results) && data.results.length === data.targetCount,
        "results 크기가 targetCount와 같아야 합니다.");

    const targetCultivationId = Number(client.variables.file.get("cultivationId"));
    const targetResult = data.results.find(function (result) {
        return Number(result.cultivationId) === targetCultivationId;
    });

    client.assert(targetResult !== undefined, "테스트 재배지가 배치 대상에 포함되어야 합니다.");
    client.assert(targetResult.status === "CREATED",
        "첫 사진 통합 테스트는 CREATED여야 합니다. EXISTING이면 사진 업로드 전에 피드백 행이 이미 존재한 것입니다.");
});
%}

### 10. DB에 저장된 피드백과 Vision 근거를 API로 조회
# 이 API는 local 프로필에서만 열리며 DB에서 조회한 저장 결과를 반환합니다.
GET {{ai}}/api/test/daily-feedbacks/{{cultivationId}}?date={{feedbackDate}}
Accept: application/json

> {%
client.test("저장된 피드백이 Vision 분석을 포함한다", function () {
    client.assert(response.status === 200, "저장 결과 조회는 HTTP 200이어야 합니다.");
    client.assert(response.body.success === true, "공통 응답 success가 true여야 합니다.");

    const data = response.body.data;
    const targetCultivationId = Number(client.variables.file.get("cultivationId"));
    client.assert(Number(data.id) > 0, "저장된 daily_feedback id는 양수여야 합니다.");
    client.assert(Number(data.cultivationId) === targetCultivationId,
        "저장된 cultivationId가 테스트 대상과 같아야 합니다.");
    client.assert(data.feedbackDate === client.variables.file.get("feedbackDate"),
        "저장된 feedbackDate가 테스트 날짜와 같아야 합니다.");
    client.assert(data.hasVisionAnalysis === true,
        "사진을 올린 실행에서는 hasVisionAnalysis가 true여야 합니다.");
    client.assert(typeof data.contextSnapshot === "object"
        && data.contextSnapshot !== null
        && !Array.isArray(data.contextSnapshot),
        "contextSnapshot은 JSON object여야 합니다.");

    const expectedContextKeys = [
        "cultivationDetail",
        "cultivationId",
        "currentThresholds",
        "dataGeneratorSnapshotAt",
        "environmentCompliance",
        "feedbackDate",
        "mushroomReference",
        "notificationMetrics",
        "sensorStatistics",
        "visionAnalysis"
    ].sort();
    const actualContextKeys = Object.keys(data.contextSnapshot).sort();
    client.assert(JSON.stringify(actualContextKeys) === JSON.stringify(expectedContextKeys),
        "contextSnapshot은 합의한 열 개의 도메인 필드만 가져야 합니다.");
    client.assert(Number(data.contextSnapshot.cultivationId) === targetCultivationId,
        "contextSnapshot.cultivationId가 테스트 대상과 같아야 합니다.");
    client.assert(data.contextSnapshot.feedbackDate === client.variables.file.get("feedbackDate"),
        "contextSnapshot.feedbackDate가 테스트 날짜와 같아야 합니다.");

    const expectedHeadings = [
        "## 오늘의 환경 요약",
        "## 센서별 통계",
        "## 이탈 및 제어",
        "## Vision 분석",
        "## 내일의 관리 포인트"
    ];
    const contentLines = data.content.split(/\r?\n/);
    const headingPattern = /^ {0,3}#{1,6}(?!#)(?:[\t ]+.*)?$/;
    const headingIndexes = [];
    const actualHeadings = contentLines.filter(function (line, index) {
        if (headingPattern.test(line)) {
            headingIndexes.push(index);
            return true;
        }
        return false;
    });

    client.assert(JSON.stringify(actualHeadings) === JSON.stringify(expectedHeadings),
        "피드백의 다섯 Markdown 제목과 순서가 계약과 같아야 합니다.");
    headingIndexes.forEach(function (headingIndex, sectionIndex) {
        const bodyEnd = sectionIndex + 1 < headingIndexes.length
            ? headingIndexes[sectionIndex + 1]
            : contentLines.length;
        const hasBody = contentLines.slice(headingIndex + 1, bodyEnd).some(function (line) {
            return line.trim().length > 0;
        });
        client.assert(hasBody, "모든 피드백 섹션에는 비어 있지 않은 본문이 있어야 합니다.");
    });
    client.assert(data.content.indexOf("```") === -1 && data.content.indexOf("~~~") === -1,
        "피드백에 코드 펜스가 없어야 합니다.");
    client.assert(!/(?:https?|s3):\/\/|x-amz-|x-goog-/i.test(data.content),
        "피드백에 외부 URL이나 서명 정보가 없어야 합니다.");
    client.assert(!/\b(?:cultivation[_-]?(?:photo[_-]?)?id|mushroom[_-]?id|threshold[_-]?id|sensor[_-]?type[_-]?id|growth[_-]?record[_-]?id|photo[_-]?id|(?:owner[_-]?)?user[_-]?id|presigned[_-]?url|object[_-]?key)\b/i.test(data.content),
        "피드백에 내부 식별자나 저장소 필드명이 없어야 합니다.");

    const vision = data.contextSnapshot.visionAnalysis;
    client.assert(typeof vision === "object" && vision !== null,
        "contextSnapshot에 visionAnalysis가 있어야 합니다.");
    client.assert(vision.hasVisionAnalysis === true,
        "visionAnalysis.hasVisionAnalysis가 true여야 합니다.");
    client.assert(Number(vision.growthRecordId) > 0,
        "Vision 결과가 growth_record에 저장되어 양수 ID를 가져야 합니다.");
    client.assert(Number(vision.cultivationPhotoId) > 0,
        "Vision 분석에 cultivationPhotoId가 있어야 합니다.");

    const uploadedPhotoId = client.global.get("uploadedDailyFeedbackPhotoId");
    client.assert(uploadedPhotoId !== null && uploadedPhotoId !== undefined,
        "7번 사진 업로드 요청을 먼저 성공시켜야 합니다.");
    client.assert(Number(vision.cultivationPhotoId) === Number(uploadedPhotoId),
        "저장된 Vision 분석이 방금 업로드한 사진을 가리켜야 합니다.");

    client.assert(typeof vision.analysisData === "object" && vision.analysisData !== null,
        "Vision 원본 분석 데이터가 JSON object로 저장되어야 합니다.");
    client.assert(vision.analysisData.status === "SUCCESS"
        || vision.analysisData.status === "NO_MUSHROOM_DETECTED",
        "저장된 Vision status가 유효해야 합니다.");
});
%}

### 11. 선택: 같은 배치를 다시 실행해 중복 저장 방지 확인
POST {{ai}}/api/test/daily-feedbacks/run?date={{feedbackDate}}
Accept: application/json

> {%
client.test("같은 재배지와 날짜의 재실행은 EXISTING을 반환한다", function () {
    client.assert(response.status === 200, "재실행도 HTTP 200이어야 합니다.");

    const targetCultivationId = Number(client.variables.file.get("cultivationId"));
    const targetResult = response.body.data.results.find(function (result) {
        return Number(result.cultivationId) === targetCultivationId;
    });

    client.assert(targetResult !== undefined, "테스트 재배지가 재실행 결과에 포함되어야 합니다.");
    client.assert(targetResult.status === "EXISTING",
        "동일 날짜 재실행은 새 행이 아니라 EXISTING을 반환해야 합니다.");
});
%}
